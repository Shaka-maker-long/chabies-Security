PORT=8080
TZ=Africa/Johannesburg

# Live database is JSON files on the Railway volume (DATA_DIR=/app/data in Docker).
# Google Sheets is NOT the database. Attach a Volume at /app/data.
DATA_DIR=

# Optional: Drive QC PDFs / powder-list emails only. Not required for shop or office data.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GMAIL_SENDER=

# One-time copy of the old spreadsheet only. Leave unset. After copying, remove this.
# GOOGLE_MIGRATE=1
# SHEET_ID=
