# Shop data lives on disk (Railway volume /app/data). Google is for one-time import and Drive QC PDFs.
# On Railway, attach a Volume at /app/data. GET /health must show usingEphemeralDisk: false.
DATA_DIR=

# Paste the full Google service account JSON as one line, or set GOOGLE_APPLICATION_CREDENTIALS to a file path.
# Share the spreadsheet (and Drive QC folders) with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional. If unset, QC PDFs / powder-list emails / glass alerts are skipped (floor still works).
GMAIL_SENDER=
