PORT=8080
TZ=Africa/Johannesburg

# Live database is SQLite at DATA_DIR/studio-delta.db on the Railway volume.
# Google Sheets is NOT the database. Attach a Volume at /app/data.
DATA_DIR=

# Staging clone (updates / phone testing). Set on the Railway staging environment only.
# Shows a red STAGING banner and seeds Admin/admin when Users is empty.
# APP_ENV=staging
# STAGING=1
# LOCAL_ADMIN_CODE=admin

# Optional emergency only (not shown on the login screen). Unlocks a Manager device via API
# if every Manager phone is lost. Prefer approving devices under Users → Devices.
# DEVICE_BOOTSTRAP_CODE=

# Force Secure cookies on/off (default: Secure on Railway / HTTPS).
# COOKIE_SECURE=1

# Optional: Drive QC PDFs / powder-list emails, and off-site backups.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GMAIL_SENDER=

# Off-site backups (recommended). Share a Drive folder with the service account, then paste its ID.
# BACKUP_DRIVE_FOLDER_ID=
# BACKUP_EMAIL=
# BACKUP_SHARE_EMAIL=

# One-time copy of the old spreadsheet only. Leave unset. After copying, remove this.
# GOOGLE_MIGRATE=1
# SHEET_ID=
